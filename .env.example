# Copy to .env and fill in. `.env` is gitignored and must stay that way.
#
# Nothing here is required to run the test suite — the suite uses LLM_PROVIDER=fake
# and needs no key at all. These are only needed to run against real models.

# ---------------------------------------------------------------------------
# Database. The default matches docker-compose.yml; override only to point at
# a Postgres you manage yourself. Must be a pgvector-enabled Postgres.
#
# `db:5432` is the address *inside* the compose network — leave it alone.
# From the host (running pytest or alembic in a local venv) the database is on
# localhost:55432, not 5432, to avoid colliding with a locally installed Postgres.
# ---------------------------------------------------------------------------
DATABASE_URL=postgresql+psycopg://ledger:ledger@db:5432/ledger

# Host port for the database. Change only if 55432 is also taken.
DB_HOST_PORT=55432

# ---------------------------------------------------------------------------
# Model provider: "gemini" for real calls, "fake" for the deterministic stub.
# ---------------------------------------------------------------------------
LLM_PROVIDER=gemini

# Google AI Studio key (https://aistudio.google.com/apikey). Not a GCP OAuth token —
# it is passed as a ?key= query parameter, not a Bearer header.
GEMINI_API_KEY=

# Model IDs are configuration, never constants in code.
#
# READ THIS BEFORE CHANGING THE MODEL — the Gemini free tier caps requests at
# 20 per DAY, per model. Not per minute. (Quota ID:
# GenerateRequestsPerDayPerProjectPerModel-FreeTier, measured 2026-08-15.)
# One run over a 7-document corpus makes ~33 calls, so the daily budget of a single
# model does not cover a single full run. Hence a lite model by default, plus a
# fallback chain below.
#
# Note also: gemini-2.5-flash — the obvious default, still shown in most tutorials
# and still returned by GET /v1beta/models — returns 404 "no longer available to new
# users" on keys created recently. Listing a model does not mean your key can call it.
GEMINI_MODEL=gemini-3.1-flash-lite
GEMINI_MODEL_CHEAP=gemini-3.1-flash-lite

# Tried in order when the model above is out of daily quota. Because the cap is per
# model, each entry is a fresh budget. Substitutions are logged at WARNING.
GEMINI_MODEL_FALLBACKS=gemini-flash-lite-latest,gemini-3-flash-preview,gemini-flash-latest

# Outbound pacing (requests/minute). Does not help with the daily cap — nothing does —
# but keeps bursts from tripping the per-minute limiter on top of it.
GEMINI_REQUESTS_PER_MINUTE=15

# ---------------------------------------------------------------------------
# Logging
# ---------------------------------------------------------------------------
LOG_LEVEL=INFO
# "human" for aligned console output, "json" for log aggregators.
LOG_FORMAT=human

# ---------------------------------------------------------------------------
# Ingestion
# ---------------------------------------------------------------------------
WATCH_DIR=/data/inbox
